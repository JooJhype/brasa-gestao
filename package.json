{
  "name": "brasa-gestao",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "description": "Gestão local de pedidos, estoque, fichas técnicas e custos para hamburguerias",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "electron .",
    "start:web": "node src/server.mjs",
    "build": "node scripts/build-windows.mjs",
    "pack": "electron-builder --config electron-builder.json --win --x64 --dir",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm run format:check",
    "verify": "npm run check && npm test"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9"
  }
}
