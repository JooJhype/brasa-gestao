{
  "name": "brasa-gestao",
  "version": "1.2.0-dev.2",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "description": "Estoque, fichas técnicas e resultado de uma hamburgueria local",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "electron .",
    "start:web": "node src/server.mjs",
    "build": "node scripts/build-windows.mjs",
    "pack": "electron-builder --config electron-builder.json --win --x64 --dir",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/server.mjs && node --check public/app.js && node --check desktop/main.mjs"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  }
}
